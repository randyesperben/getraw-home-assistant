{
  "config": {
    "step": {
      "user": {
        "title": "Conectar RAW",
        "description": "Escanea este código con la cámara del teléfono y toca Conectar en RAW. Después, selecciona Continuar.\n\n¿Estás en el teléfono? [Abrir en RAW]({link})\n\nRAW llega a este Home Assistant en {address}. Si el teléfono no abre esa dirección, cambia Red local en Configuración › Sistema › Red.",
        "data": {
          "code": "Código QR"
        },
        "submit": "Continuar"
      },
      "show_code": {
        "title": "Volver a conectar RAW",
        "description": "Escanea este código con la cámara del teléfono y toca Conectar en RAW. Después, selecciona Continuar.\n\n¿Estás en el teléfono? [Abrir en RAW]({link})\n\nRAW llega a este Home Assistant en {address}. Si el teléfono no abre esa dirección, cambia Red local en Configuración › Sistema › Red.",
        "data": {
          "code": "Código QR"
        },
        "submit": "Continuar"
      },
      "reconfigure": {
        "menu_options": {
          "show_code": "Mostrar el código QR de nuevo",
          "rotate_key": "Renovar la clave"
        },
        "menu_option_descriptions": {
          "show_code": "Un código nuevo para otro teléfono, o después de reinstalar RAW.",
          "rotate_key": "RAW pasa a una clave nueva con su próximo mensaje. Úsalo si alguien puede tener una copia de los datos de este Home Assistant, como una copia de seguridad. Si alguien ha podido ver el código QR, muestra el código QR de nuevo."
        }
      }
    },
    "progress": {
      "wait_for_phone": "Esperando a RAW en el teléfono. Toca Conectar en RAW en los próximos 2 minutos."
    },
    "error": {
      "no_answer": "RAW no ha respondido. Comprueba que el teléfono está en la misma wifi y que RAW puede usar la red local (iPhone: Ajustes › RAW › Red local).",
      "other_account": "Ese teléfono tiene otra cuenta de RAW. Entra en RAW con la cuenta de este dispositivo, o vuelve a añadir RAW para la otra cuenta."
    },
    "abort": {
      "reconnected": "RAW vuelve a estar conectado. Su dispositivo, sus entidades y su historial siguen igual.",
      "key_rotated": "RAW recibirá la clave nueva con su próximo mensaje.",
      "no_address": "Home Assistant no tiene ninguna dirección a la que RAW pueda llegar. Rellena Red local en Configuración › Sistema › Red."
    }
  },
  "issues": {
    "unsupported_version": {
      "title": "Actualiza RAW en el Marketplace",
      "description": "{name} envía mensajes que esta versión de la integración RAW no sabe leer. Actualiza RAW en el Marketplace."
    },
    "phone_disconnected": {
      "title": "{name} se desconectó en el teléfono",
      "description": "RAW dejó de enviar a Home Assistant desde el teléfono. Para volver a conectar, abre Ajustes › Home Assistant en RAW. Si ya no lo usas, elimina esta integración."
    },
    "silent": {
      "title": "Sin noticias de {name} en 14 días",
      "description": "Home Assistant no ha recibido nada de RAW en 14 días. Abre RAW en el teléfono. Si dice que Home Assistant no responde, selecciona Reconfigurar en esta integración y muestra el código QR de nuevo."
    },
    "clock": {
      "title": "Los relojes de {name} y de Home Assistant no coinciden",
      "description": "El reloj del teléfono y el de este Home Assistant se han separado más de 2 minutos desde que RAW se conectó. Hasta que vuelvas a conectarlo, Home Assistant se salta los eventos del entreno y muestra sus horas antes de las reales. Selecciona Reconfigurar en esta integración y muestra el código QR de nuevo."
    }
  },
