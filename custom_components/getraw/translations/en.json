{
  "config": {
    "step": {
      "user": {
        "title": "Connect RAW",
        "description": "Scan this code with your phone's camera and tap Connect in RAW. Then select Continue.\n\nOn this phone? [Open in RAW]({link})\n\nRAW reaches this Home Assistant at {address}. If your phone can't open that address, change Local network in Settings › System › Network.",
        "data": {
          "code": "QR code"
        },
        "submit": "Continue"
      },
      "show_code": {
        "title": "Connect RAW again",
        "description": "Scan this code with your phone's camera and tap Connect in RAW. Then select Continue.\n\nOn this phone? [Open in RAW]({link})\n\nRAW reaches this Home Assistant at {address}. If your phone can't open that address, change Local network in Settings › System › Network.",
        "data": {
          "code": "QR code"
        },
        "submit": "Continue"
      },
      "reconfigure": {
        "menu_options": {
          "show_code": "Show the QR code again",
          "rotate_key": "Rotate key"
        },
        "menu_option_descriptions": {
          "show_code": "A new code for a new phone, or after you reinstall RAW.",
          "rotate_key": "RAW switches to a fresh key with its next message. Use it if someone may have a copy of this Home Assistant's data, such as a backup. If someone may have seen the QR code, show the QR code again instead."
        }
      }
    },
    "progress": {
      "wait_for_phone": "Waiting for RAW on your phone. Tap Connect in RAW within 2 minutes."
    },
    "error": {
      "no_answer": "RAW didn't answer. Check that the phone is on the same Wi-Fi and that RAW is allowed to use the local network (iPhone: Settings › RAW › Local Network).",
      "other_account": "That phone is signed in to another RAW account. In RAW, sign in with this device's account, or add RAW again for the other account."
    },
    "abort": {
      "reconnected": "RAW is connected again. Its device, entities and history stay as they were.",
      "key_rotated": "RAW gets the new key with its next message.",
      "no_address": "Home Assistant has no address RAW can reach. Fill in Local network in Settings › System › Network."
    }
  },
  "issues": {
    "unsupported_version": {
      "title": "Update RAW in the Marketplace",
      "description": "{name} sends messages this version of the RAW integration can't read. Update RAW in the Marketplace."
    },
    "phone_disconnected": {
      "title": "{name} disconnected on the phone",
      "description": "RAW stopped sending to Home Assistant from the phone. To connect again, open Profile › Settings › Home Assistant in RAW. If you no longer use it, delete this integration."
    },
    "silent": {
      "title": "No news from {name} in 14 days",
      "description": "Home Assistant hasn't received anything from RAW in 14 days. Open RAW on the phone. If it says Home Assistant isn't answering, select Reconfigure on this integration and show the QR code again."
    },
    "clock": {
      "title": "The clocks of {name} and Home Assistant disagree",
      "description": "The phone's clock and this Home Assistant's moved more than 2 minutes apart after RAW connected. Until you connect it again, Home Assistant skips workout events and shows workout times earlier than they were. Select Reconfigure on this integration and show the QR code again."
    }
  },
